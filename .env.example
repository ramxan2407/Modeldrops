# Private Sites preview (D1 and R2 binding names live in .openai/hosting.json)
ADMIN_USER_IDS=
SUPER_ADMIN_USER_IDS=
JOB_RUNNER_SECRET=

# Provider and backend credentials (server only).
DATABASE_URL=
WAVESPEED_API_KEY=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_ORIGIN=
LIVE_PAYMENTS_ENABLED=false
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=
SENTRY_DSN=
POSTHOG_KEY=
RESEND_API_KEY=

# Supabase Auth (server runtime values; never use a service-role key here)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=false
# APP_ORIGIN above must be the exact application origin, without a path.

# Manual LoRA training emails (same RESEND_API_KEY as above)
LORA_EMAIL_FROM=
LORA_ADMIN_EMAILS=
# ADMIN_USER_IDS is comma-separated supabase:<user UUID>, never email addresses.
# Schedule POST /api/jobs every minute with Authorization: Bearer <CRON_SECRET>.
# scripts/configure-supabase-scheduler.mjs installs the Supabase scheduler.

# Vercel workspace backend (Supabase Postgres transaction pooler and private S3)
# DATABASE_URL, STORAGE_ENDPOINT, STORAGE_BUCKET and S3 credentials are listed above.
STORAGE_REGION=ap-southeast-2
# Match the storage plan limit; Supabase Free supports 50 MB files.
MAX_LORA_UPLOAD_BYTES=52428800
# APP_ORIGIN may be omitted on Vercel to use its generated VERCEL_URL.

# Live WaveSpeed generation; missing keys disable generation instead of using demo output.
WAVESPEED_ENABLED=false
WAVESPEED_DAILY_LIMIT_USD=5
WAVESPEED_OUTPUT_HOSTS=
CRON_SECRET=
WELCOME_CREDITS=0

# Explicit demo wallet; separate from paid credits. Live AI calls still spend API balance.
DEMO_MODE=false
DEMO_WELCOME_CREDITS=0
# Invite testers and grant their credits in the super-admin dashboard.
GENERATION_REQUESTS_PER_MINUTE=6
GENERATION_USER_DAILY_LIMIT_USD=2
DEMO_TOTAL_LIMIT_USD=25

# Isolated local/test databases only. Ignored on Vercel production.
# Never connect a public test checkout to production credentials.
CHARACTER_TEST_CHECKOUT=false
