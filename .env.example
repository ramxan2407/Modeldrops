# Private Sites preview (D1 and R2 binding names live in .openai/hosting.json)
ADMIN_USER_IDS=
JOB_RUNNER_SECRET=

# Separate production application — these DO NOT enable live billing in the demo.
DATABASE_URL=
WAVESPEED_API_KEY=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_ORIGIN=
LIVE_PAYMENTS_ENABLED=false
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=
SENTRY_DSN=
POSTHOG_KEY=
RESEND_API_KEY=

# Supabase Auth (server runtime values; never use a service-role key here)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=false
# APP_ORIGIN above must be the exact application origin, without a path.
